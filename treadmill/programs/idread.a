; idread.a: the C64 side of a read-margin sweep, as a one-bank EasyFlash cartridge.
; A launched PRG runs under the None IO handler, where nothing answers at IO1
; (seen on the bench), so the reads to count come from a cartridge: its ROM at
; $8000, which the TeensyROM drives straight from the image right after the
; nS_PLAprop wait, and the EasyFlash handler's RAM at $DF00, which it drives
; only after both ROM tests and a call into the handler. The two paths have
; different edges, so they are counted apart.
; The EasyFlash handler starts the cartridge in Ultimax mode, as the hardware
; boots, so bank 0's ROMH (at $E000 then) carries the reset vector and a stub
; that switches to 8K mode from RAM and restarts the KERNAL's reset, which finds
; the CBM80 entry at $8000. The image is bank 0's ROML ($8000) and ROMH, then
; bank 1's ROML, 8 KB each.
; A loop copied to RAM rewrites the IO2 page each pass, reads two pages of ROM
; and the IO2 page whose bytes it knows, and counts wrong answers at $C000,
; where the sweep reads them by DMA: the TeensyROM cannot see its own read
; errors, only the C64 can. Only data reads go through the cartridge, so a read
; that fails is counted rather than executed.
; The C64's writes are checked through what they leave behind. The IO2 page's
; pattern changes every pass, so a write that is dropped, or taken as a read,
; leaves last pass's byte and shows as a wrong IO2 read. Each pass also writes
; the bank register $DE00, banks 0 and 1 in turn, and bank 1's ROM pages hold
; bank 0's XOR BANK1, so a bank write dropped or latched with the wrong data
; turns that pass's ROM reads wrong.
;   $C000/1  passes, 16-bit (256 rounds each: two ROM reads, one IO2 read)
;   $C002-4  wrong ROM reads, 24-bit
;   $C005-7  wrong IO2 reads, 24-bit
; With SHOW defined, every 32nd pass also writes the three counters in hex on
; the top row (passes, wrong ROM, wrong IO2), for an image that refuses DMA:
; MinimalBoot answers only reset, launch, version and the firmware check. Not
; every pass: a 30 fps capture of a 60 Hz picture blends two frames, and a digit
; that changes every frame never reads whole (C64 #14, 2026-11-21).

RES  = $c000
SCREEN = $0400
LOOP = $c100
IO2  = $df00
EFBANK = $de00                      ; EasyFlash bank register, write-only
EFCTL = $de02                       ; EasyFlash control: $06 is 8K mode (EXROM low, GAME high)
BANK1 = $c0                         ; bank 1's ROM pages are bank 0's XOR this; the IO2 page's
                                    ; keys ($40-$7F) are never a ROM page's (0, $FF, $C0, $3F)
ENTRY = $8009                       ; the reset entry, after the vectors and CBM80, in both banks
STUB = $0200                        ; Ultimax mode leaves RAM at $0000-$0FFF only
KRESET = $fce2                      ; the KERNAL's reset: checks $8004 for CBM80 and jumps through $8000
NMIEXIT = $febc                     ; the KERNAL's NMI exit: pulls Y, X, A, then RTI

; The start of both banks' ROML, byte for byte: a reset can find either bank selected.
!macro header {
    !word ENTRY, NMIEXIT            ; reset; NMI: RESTORE reaches $8002 with A, X, Y pushed,
                                    ; and must not restart the counters mid-sample
    !byte $c3, $c2, $cd, $38, $30   ; "CBM80": the KERNAL's reset jumps through $8000
    !if * != ENTRY { !error "the entry moved: set ENTRY" }
    lda #$00
    sta EFBANK                      ; bank 0; the jmp is then fetched from bank 0, which holds
    jmp cold                        ; the same bytes here
}

* = $8000
    +header

cold:
    sei
    jsr $ff84                       ; IOINIT
    jsr $ff87                       ; RAMTAS
    jsr $ff8a                       ; RESTOR
    jsr $ff81                       ; CINT: a blank screen for whoever watches
!ifdef SHOW {
    lda #$00                        ; light grey on black, the colors the glyph banks are harvested in
    sta $d020
    sta $d021
    lda #$0f
    ldx #39
-   sta $d800,x
    dex
    bpl -
}
    sei
    lda #$00
    ldx #$07
-   sta RES,x
    dex
    bpl -
    ldx #$00
-   lda loop_image,x
    sta LOOP,x
    inx
    cpx #loop_end - loop_image
    bne -
    jmp LOOP

loop_image:
!pseudopc LOOP {
pass:
    lda RES                         ; the pass count's low byte picks the bank and the IO2 pattern
    and #$01
    sta EFBANK
    beq +
    lda #BANK1
+   sta upkey+1                     ; the ROM pages' keys for the bank just selected
    eor #$ff
    sta downkey+1
    lda RES
    and #$3f
    ora #$40                        ; $40-$7F, and never last pass's
    sta wkey+1
    sta rkey+1
    ldy #$00
-   tya
wkey:
    eor #$00
    sta IO2,y
    iny
    bne -
round:
    tya
upkey:
    eor #$00
    cmp up,y
    beq +
    jsr wrong_rom
+   tya
downkey:
    eor #$ff
    cmp down,y
    beq +
    jsr wrong_rom
+   tya
rkey:
    eor #$00
    cmp IO2,y
    beq +
    jsr wrong_io
+   iny
    bne round
!ifdef SHOW {
    inc RES
    bne +
    inc RES+1
+   lda RES
    and #$1f                        ; every 32 passes, about four times a second
    bne +
    jsr show
+   jmp pass
} else {
    inc RES
    bne pass
    inc RES+1
    jmp pass
}

wrong_rom:
    inc RES+2
    bne +
    inc RES+3
    bne +
    inc RES+4
+   rts

wrong_io:
    inc RES+5
    bne +
    inc RES+6
    bne +
    inc RES+7
+   rts

!ifdef SHOW {
show:                               ; Y is 0 here, and pass sets it again
    lda $d012                       ; the beam on line 128, under the top row: the VIC fetches
    cmp #$80                        ; that row's codes once a frame, on line 51, so it never
    bne show                        ; takes them half written
    lda RES+1
    jsr hex
    lda RES
    jsr hex
    iny
    lda RES+4
    jsr hex
    lda RES+3
    jsr hex
    lda RES+2
    jsr hex
    iny
    lda RES+7
    jsr hex
    lda RES+6
    jsr hex
    lda RES+5
    ; falls through

hex:                                ; A as two digits at SCREEN+Y; Y moves on two
    pha
    lsr
    lsr
    lsr
    lsr
    tax
    lda digits,x
    sta SCREEN,y
    iny
    pla
    and #$0f
    tax
    lda digits,x
    sta SCREEN,y
    iny
    rts

digits:                             ; in the loop's RAM copy: a failed ROM read must not show as a count
    !scr "0123456789abcdef"
}
}
loop_end:

    !align $ff, 0, $ff
up:                                 ; up[i] = i
    !for i, 0, 255 { !byte i }
down:                               ; down[i] = i XOR $ff
    !for i, 0, 255 { !byte i XOR $ff }

    !fill $a000 - *, $ff

; ROMH, seen at $E000 in Ultimax mode.
!pseudopc $e000 {
boot:
    sei
    ldx #$ff
    txs
    cld
    ldx #stub_end - stub_image - 1
-   lda stub_image,x
    sta STUB,x
    dex
    bpl -
    jmp STUB
stub_image:
!pseudopc STUB {
    lda #$06
    sta EFCTL                       ; ROMH leaves, KERNAL and ROML appear
    jmp KRESET
}
stub_end:
nmi:
    rti
    !fill $fffa - *, $ff
    !word nmi, boot, nmi            ; NMI, reset, IRQ
}

; Bank 1's ROML: the same start, then the ROM pages XOR BANK1 where bank 0 has them.
!pseudopc $8000 {
    +header
    !fill up - *, $ff
    !for i, 0, 255 { !byte i XOR BANK1 }
    !for i, 0, 255 { !byte i XOR $ff XOR BANK1 }
    !fill $a000 - *, $ff
}
