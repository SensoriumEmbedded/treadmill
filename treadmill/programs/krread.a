; krread.a: the C64 side of the krread probe, run under Kernal Replace with a probe
; KERNAL: the machine's own KERNAL with a run of filler bytes (MARK, LEN bytes of
; FILL) inverted. IRQs off. Each pass sets HIRAM ($01 = $37) and reads the run, where
; the TeensyROM must serve the inverted bytes; then clears it ($01 = $35) and reads
; the same addresses, where the C64 must see its own RAM (PAT, written there first).
; Every write to $01 makes the TeensyROM sense HIRAM again, on the next KERNAL read
; (Cyc_KernProp, Skoe) or in a stolen cycle right after the write (nS_KSenseSample,
; DMA), so every pass is two senses. The first read of each half is counted apart
; from the rest: under Skoe it is the sense's own cycle, and the rest show the
; verdict. Counters at $C110, 16 bits each: passes; the rest of the reads where the
; replacement was missing (ROM side) and where it came over RAM (RAM side); the
; first reads, the same two ways. $5A at $C104 once running.
; Every 256 passes it also writes the five counters in hex on the top row (cells
; 0, 5, 10, 15 and 20, four digits each), light grey on black as the glyph banks
; are harvested, where the probe reads them by video: host DMA while a program
; runs under Kernal Replace corrupts the program and leaves the DMA sense on a
; stale verdict, so nothing reads the counters by DMA while krread runs. Not
; every pass: a 30 fps capture of a 60 Hz picture blends two frames, and a digit
; that changes every frame never reads whole (C64 #14, 2026-11-21).

SCREEN   = $0400
ready    = $c104
passes   = $c110
romwrong = $c112
ramwrong = $c114
romfirst = $c116
ramfirst = $c118

* = $0801
!word next, 10
!byte $9e
!text "2064"
!byte 0
next !word 0

* = $0810
        sei
        lda #$7f
        sta $dc0d
        sta $dd0d
        lda $dc0d
        lda $dd0d
        lda #0
        sta $d01a
        sta $d020
        sta $d021
        lda #$15                ; screen at $0400, the ROM's upper case and graphics
        sta $d018
        ldx #39
-       lda #$0f                ; light grey
        sta $d800,x
        lda #$20
        sta SCREEN,x
        dex
        bpl -
        lda #0
        ldx #9
-       sta passes,x
        dex
        bpl -
        lda #$35
        sta $01
        ldx #LEN - 1
        lda #PAT
-       sta MARK,x              ; RAM under the KERNAL
        dex
        bpl -
        lda #$5a
        sta ready

loop    lda #$37                ; KERNAL in: the replacement's bytes
        sta $01
        lda MARK + LEN - 1
        cmp #FILL XOR $ff
        beq +
        inc romfirst
        bne +
        inc romfirst+1
+       ldx #LEN - 2
-       lda MARK,x
        cmp #FILL XOR $ff
        beq +
        inc romwrong
        bne +
        inc romwrong+1
+       dex
        bpl -
        lda #$35                ; KERNAL out: RAM
        sta $01
        lda MARK + LEN - 1
        cmp #PAT
        beq +
        inc ramfirst
        bne +
        inc ramfirst+1
+       ldx #LEN - 2
-       lda MARK,x
        cmp #PAT
        beq +
        inc ramwrong
        bne +
        inc ramwrong+1
+       dex
        bpl -
        inc passes
        bne +
        inc passes+1
+       lda passes
        bne +                   ; every 256 passes, about four times a second: see show
        jsr show
+       jmp loop

show    lda $d012               ; the beam on line 128, under the top row: the VIC fetches that row's codes
        cmp #$80                ; once a frame, on line 51, so it never takes them half written ($01 is $35
        bne show                ; here: the VIC's registers, and the screen and the digits are RAM)
        ldy #0
        lda passes+1
        jsr hex
        lda passes
        jsr hex
        iny
        lda romwrong+1
        jsr hex
        lda romwrong
        jsr hex
        iny
        lda ramwrong+1
        jsr hex
        lda ramwrong
        jsr hex
        iny
        lda romfirst+1
        jsr hex
        lda romfirst
        jsr hex
        iny
        lda ramfirst+1
        jsr hex
        lda ramfirst
        ; falls through

hex     pha                     ; A as two digits at SCREEN+Y; Y moves on two
        lsr
        lsr
        lsr
        lsr
        tax
        lda digits,x
        sta SCREEN,y
        iny
        pla
        and #$0f
        tax
        lda digits,x
        sta SCREEN,y
        iny
        rts

digits  !scr "0123456789abcdef"
