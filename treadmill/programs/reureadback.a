; reureadback.a: the C64 side of the REU read-back soak. IRQs off. The loop stashes a page
; to the REU, fetches it back to another page and compares, counting rounds and
; mismatches, as reuclient.a does. Every REU register write is also read back before the
; transfer starts. A register that reads back wrong is counted, the value a second read
; found is kept, and the write is repeated until it holds: a C64 IO2 write isrPHI2 missed
; or latched late reads back what the last transfer left there. A transfer leaves the low
; address bytes and the bank as it found them, so each round aims at a REU address and
; bank of its own, and a lost write to $DF04 or $DF06 shows on the stash. $DF02 is the same
; every round, so a lost write there goes uncounted. With -DSPRITES=1 all eight sprites are
; on, double height, so BA drops on most display lines. A CIA2 timer NMI, if a host starts
; it, stores to $D418 for locked slices to start on.
;
; With -DHAMMER=1 there are no transfers: $DF02-$DF08 are set once, and the loop reads them
; back over and over, an IO2 read every 9 cycles, so a cycle isrPHI2 answers late is caught
; about 60 times as often as by the transfer loop. A read that differs is counted against
; its register, with the wrong value itself kept; rounds counts 256 passes over the seven.
;
; Copied from TeensyROM's tools/bench/reuclient.a as PR #111 extends it, so the soak stays
; the same whatever firmware is under test. MIT License, Copyright (c) 2023 Travis Smith.
* = $0801
!word next, 10
!byte $9e
!text "2064"
!byte 0
next !word 0

ready  = $c104          ; $5A once set up
rounds = $c110          ; 16 bits
errors = $c112          ; 16 bits
seed   = $c114
misslo = $c120          ; per register $DF02-$DF08: read-back misses, low bytes
misshi = $c128          ; and high bytes
lastrd = $c130          ; the value a second read found after the last miss
source = $4000
dest   = $5000
expect = $f7            ; HAMMER: what each register read back once set, 7 bytes
pass   = $fe            ; HAMMER: passes toward the next round

reu_cmd  = $df01
reu_regs = $df02        ; C64 address, REU address and bank, length: 7 registers
stash    = $90          ; execute now, C64 to REU
fetch    = $91          ; execute now, REU to C64

* = $0810
        sei
        lda #$7f
        sta $dc0d
        sta $dd0d
        lda $dc0d
        lda $dd0d
        lda #0
        sta $d01a
        sta rounds
        sta rounds+1
        sta errors
        sta errors+1
        sta seed
        ldx #$17
-       sta misslo,x
        dex
        bpl -
        lda #<nmi
        sta $0318
        lda #>nmi
        sta $0319
!ifdef SPRITES {
        ldx #7
-       txa
        asl
        tay
        lda #160
        sta $d000,y
        lda sprite_y,x
        sta $d001,y
        lda #$0d                ; any block: only the fetches matter
        sta $07f8,x
        dex
        bpl -
        lda #0
        sta $d010
        lda #$ff
        sta $d017
        sta $d015
}
!ifdef HAMMER {
        ldx #6
-       lda hvals,x
        sta reu_regs,x
        lda reu_regs,x          ; what the register holds, unused bits included
        sta expect,x
        dex
        bpl -
        lda #0
        sta pass
}
        lda #$5a
        sta ready

!ifdef HAMMER {
hammer  lda reu_regs
        cmp expect
        bne m0
        lda reu_regs+1
        cmp expect+1
        bne m1
        lda reu_regs+2
        cmp expect+2
        bne m2
        lda reu_regs+3
        cmp expect+3
        bne m3
        lda reu_regs+4
        cmp expect+4
        bne m4
        lda reu_regs+5
        cmp expect+5
        bne m5
        lda reu_regs+6
        cmp expect+6
        bne m6
        inc pass
        bne hammer
        inc rounds
        bne hammer
        inc rounds+1
        jmp hammer
m0      ldx #0                  ; A still holds the wrong read
        beq hmiss
m1      ldx #1
        bne hmiss
m2      ldx #2
        bne hmiss
m3      ldx #3
        bne hmiss
m4      ldx #4
        bne hmiss
m5      ldx #5
        bne hmiss
m6      ldx #6
hmiss   sta lastrd,x
        inc misslo,x
        bne hammer
        inc misshi,x
        jmp hammer

hvals   !byte $a5, $3c, $c3, $5a, $01, $96, $69
}

loop    inc seed
        ldx #0
-       txa
        eor seed
        sta source,x
        inx
        bne -
        lda #>source
        ldy #stash
        jsr transfer
        lda #>dest
        ldy #fetch
        jsr transfer
        ldx #0
-       lda dest,x
        cmp source,x
        bne bad
        inx
        bne -
        inc rounds
        bne loop
        inc rounds+1
        jmp loop
bad     inc errors
        bne loop
        inc errors+1
        jmp loop

; A = C64 page, Y = command. 256 bytes at the round's REU address, seed in bank
; seed & 1, which every REU size has.
transfer
        sta regs+1
        lda seed
        sta regs+2
        and #1
        sta regs+4
        lda #0
        sta regs
        sta regs+3
        sta regs+5
        lda #1
        sta regs+6
        ldx #6
store   lda regs,x
        sta reu_regs,x
        cmp reu_regs,x
        beq +
        lda reu_regs,x
        sta lastrd,x
        inc misslo,x
        bne store
        inc misshi,x
        jmp store
+       dex
        bpl store
        sty reu_cmd
        rts

regs    !fill 7

!ifdef SPRITES {
sprite_y !byte 50, 92, 134, 176, 218, 71, 113, 155
}

nmi     pha
        lda $dd0d
        lda #$0f
        sta $d418
        pla
        rti
