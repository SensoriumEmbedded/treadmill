; vicrom.a: the C64 side of the vicrom probe, an 8K Ultimax cartridge (EXROM high,
; GAME low), which the TeensyROM serves with EmulateVicCycles on: in each VIC cycle it
; samples the address at nS_VICStart after Phi2 falls and drives ROMH until
; nS_VICDHold. In Ultimax mode the VIC sees ROMH's upper 4K at $3000, so the charset
; is put there ($F000 here, $3000 to the VIC) and every glyph on screen is fetched
; from the cartridge in VIC cycles: a sample point or a release off its window shows
; as wrong pixels in the glyphs. The CPU sees RAM only at $0000-$0FFF, so the screen
; is at $0400 and the counters at $0F00: frames counted (16-bit) and $5A at $0F04
; once running. The border steps once a frame, so a hung C64 shows on video too.
; The firmware blanks $D011 before an Ultimax launch; the code turns the screen on.
;
; With HIGH, the screen matrix ($F800, $3800 to the VIC) and eight sprites ($FC00,
; $3C00) are in ROMH as well. The VIC reads those while Phi2 is high, in cycles the
; TeensyROM serves as it does the CPU's, timed by nS_RWnReady and nS_PLAprop; the
; charset is still read while Phi2 is low.


passes = $0f00
ready  = $0f04

!ifdef HIGH {
SCREEN = $3800                  ; as the VIC sees it: ROMH $F800
D018   = $ec                    ; screen $3800, charset $3000
} else {
SCREEN = $0400
D018   = $1c                    ; screen $0400, charset $3000: ROMH as the VIC sees it
}
SPRITES = $3c00                 ; HIGH: eight sprites' data, blocks 240-247 (ROMH $FC00)

* = $e000
reset   sei
        cld
        ldx #$ff
        txs
        lda #$7f
        sta $dc0d
        sta $dd0d
        lda $dc0d
        lda $dd0d
        lda #$03
        sta $dd02
        lda #$97                ; VIC bank 0
        sta $dd00
        lda #0
        sta $d015
        sta $d01a
        sta $d020
        sta $d021
        lda #$c8
        sta $d016
        lda #D018
        sta $d018
        ldx #0
-
!ifndef HIGH {
        txa
        sta $0400,x
        sta $0500,x
        sta $0600,x
        sta $06e8,x
}
        lda #1
        sta $d800,x
        sta $d900,x
        sta $da00,x
        sta $dae8,x
        inx
        bne -
!ifdef HIGH {
        ldx #7                  ; eight sprites in a row across the text area, each its own color
-       txa
        clc
        adc #2
        sta $d027,x
        dex
        bpl -
        ldx #14
        lda #40 + 7 * 26
-       sta $d000,x
        sec
        sbc #26
        dex
        dex
        bpl -
        lda #120
        ldx #14
-       sta $d001,x
        dex
        dex
        bpl -
        lda #0
        sta $d010
        sta $d017
        sta $d01b
        sta $d01c
        sta $d01d
        lda #$ff
        sta $d015
}
        lda #0
        sta passes
        sta passes+1
        lda #$1b
        sta $d011
        lda #$5a
        sta ready

frame   lda $d012               ; once a frame: line 0 (and 256, on PAL)
        bne frame
        inc $d020
        inc passes
        bne +
        inc passes+1
+
-       lda $d012
        beq -
        jmp frame

nmi
irq     rti

; 256 glyphs, every one different and none blank, so every fetch moves bits.
* = $f000
!for i, 0, 255 {
        !for r, 0, 7 {
                !byte (i * 7 + r * 29 + (i >> 2) + 1) & $ff
        }
}

!ifdef HIGH {
* = $f800                      ; the screen matrix: cell i shows code i AND $FF, as $0400 does without HIGH
!for i, 0, 999 { !byte i & $ff }
* = $fbf8                      ; sprite pointers, at the screen's end
!for s, 0, 7 { !byte (SPRITES & $3fff) / 64 + s }
* = $fc00                      ; sprite data, no row blank, each sprite its own
!for s, 0, 7 {
        !for b, 0, 63 {
                !byte ((s * 37 + b * 11 + (b >> 3) + 3) & $ff) | $01
        }
}
}

* = $fffa
        !word nmi, reset, irq
